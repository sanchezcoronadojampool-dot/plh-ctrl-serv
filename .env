# Database and authentication secrets (generate unique values for this deployment).
DB_PASSWORD=plh-ctrl-serv
JWT_SECRET=REPLACE_WITH_AT_LEAST_32_RANDOM_BYTES

# Public origin of the reverse proxy, without a path.
FRONTEND_ORIGIN=http://localhost:8080
PASSWORD_RESET_BASE_URL=http://localhost:8080/proyecto2/login/restablecer
PASSWORD_RESET_EXPIRATION_MINUTES=30
APP_TIME_ZONE=America/Lima

# Optional first administrator. Leave both blank if the database already has one.
BOOTSTRAP_ADMIN_USERNAME= ADMINISTRADOR
BOOTSTRAP_ADMIN_PASSWORD= administracion2026

# Optional SMTP configuration for password-reset and notifications.
SMTP_HOST=
SMTP_PORT=587
SMTP_USERNAME=
SMTP_PASSWORD=
SMTP_AUTH=true
SMTP_STARTTLS=true
SMTP_STARTTLS_REQUIRED=true
MAIL_FROM=
