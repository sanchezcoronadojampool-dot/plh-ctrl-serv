# Copy this file to .env and replace every marked value before starting Docker.
# Keep .env private: it must never be committed to version control.

# Database and authentication secrets (generate unique values for this deployment).
DB_PASSWORD=change-me-db-password
JWT_SECRET=change-me-32-random-bytes-minimum

# Public origin of the reverse proxy, without a path.
FRONTEND_ORIGIN=https://servicios-plh-condominio.duckdns.org
PASSWORD_RESET_BASE_URL=https://servicios-plh-condominio.duckdns.org/login/restablecer
PASSWORD_RESET_EXPIRATION_MINUTES=30
APP_TIME_ZONE=America/Lima

# First administrator created on startup when no active admin exists yet.
# docker-compose defaults are admin / AdminPlh2026! ; set your own for production
# and change the password after the first login. Existing active admins are never modified.
BOOTSTRAP_ADMIN_USERNAME=admin
BOOTSTRAP_ADMIN_PASSWORD=AdminPlh2026!

# Optional SMTP configuration for password-reset and owner decision emails.
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USERNAME=
SMTP_PASSWORD=
SMTP_AUTH=true
SMTP_STARTTLS=true
SMTP_STARTTLS_REQUIRED=true
MAIL_FROM=
